# Copy to .env and `source` it, or set in the service manager. All optional.
VERBUM_ADDR=:8080
VERBUM_FIXTURES=db/seed/fixtures.json
# VERBUM_DATABASE_URL=postgres://verbum:verbum@localhost:5432/verbum?sslmode=disable
# PORT is honoured when VERBUM_ADDR is unset (Railway/Cloud Run inject it).
# OPENAI_API_KEY=sk-...                       # enables /v1/ask, /v1/realtime/session, semantic search
# GOOGLE_APPLICATION_CREDENTIALS=/path/sa.json  # enables /v1/tts (Google Cloud TTS)
# GOOGLE_APPLICATION_CREDENTIALS_JSON='{...}'  # same, as inline JSON or base64 — for hosts without secret files
# VERBUM_TTS_CACHE_DIR=/var/cache/verbum/tts  # persistent MP3 cache (mount a volume here)

# Start in monitor mode; enforce only after App Attest/Play Integrity are configured
# and updated mobile builds have been validated on real devices.
VERBUM_APP_CHECK_MODE=monitor
# Comma-separated Firebase app IDs (not bundle IDs or installation IDs).
VERBUM_APP_CHECK_APP_IDS=
