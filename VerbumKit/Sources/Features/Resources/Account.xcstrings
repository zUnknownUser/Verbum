{
  "sourceLanguage": "en",
  "strings": {
    "account": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta"
          }
        }
      }
    },
    "welcome": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A place for your journey."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lugar para sua jornada."
          }
        }
      }
    },
    "intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore Scripture at your own pace. Create an account, sign in, or continue as a guest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore a Bíblia no seu ritmo. Crie uma conta, entre ou continue como visitante."
          }
        }
      }
    },
    "signIn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrar"
          }
        }
      }
    },
    "register": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create account"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criar conta"
          }
        }
      }
    },
    "anonymous": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue as guest"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar como visitante"
          }
        }
      }
    },
    "later": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora não"
          }
        }
      }
    },
    "close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar"
          }
        }
      }
    },
    "back": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltar"
          }
        }
      }
    },
    "email": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mail"
          }
        }
      }
    },
    "password": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Senha"
          }
        }
      }
    },
    "confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm password"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar senha"
          }
        }
      }
    },
    "show": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show password"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar senha"
          }
        }
      }
    },
    "hide": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide password"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar senha"
          }
        }
      }
    },
    "reset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset password"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperar senha"
          }
        }
      }
    },
    "forgot": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forgot password?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esqueceu a senha?"
          }
        }
      }
    },
    "sendReset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send recovery email"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar e-mail de recuperação"
          }
        }
      }
    },
    "signInTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome back."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Que bom ter você aqui."
          }
        }
      }
    },
    "signInBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with the email you used to create your account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre com o e-mail que você usou para criar sua conta."
          }
        }
      }
    },
    "registerTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin your journey."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece sua jornada."
          }
        }
      }
    },
    "registerBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an email you can access and a password with at least 8 characters."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um e-mail ao qual você tenha acesso e uma senha com pelo menos 8 caracteres."
          }
        }
      }
    },
    "resetTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fresh start."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos recomeçar."
          }
        }
      }
    },
    "resetBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We will send you a link to choose a new password."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaremos um link para você escolher uma nova senha."
          }
        }
      }
    },
    "resetSent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this email is registered, you will receive a recovery link. Check your spam folder too."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se este e-mail estiver cadastrado, você receberá um link de recuperação. Confira também a pasta de spam."
          }
        }
      }
    },
    "guest": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guest account"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta de visitante"
          }
        }
      }
    },
    "guestBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your guest identity stays on this device. Create an account to keep access after signing out or reinstalling."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua identidade de visitante fica neste aparelho. Crie uma conta para manter o acesso após sair ou reinstalar."
          }
        }
      }
    },
    "existingGuest": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already have an account? Signing in switches accounts; guest data is not merged automatically."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já tem uma conta? Ao entrar, você troca de conta; os dados do visitante não são mesclados automaticamente."
          }
        }
      }
    },
    "accountBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage your access. Reading remains available even when you sign out."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie seu acesso. A leitura continua disponível mesmo quando você sai."
          }
        }
      }
    },
    "verified": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email verified"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mail verificado"
          }
        }
      }
    },
    "unverified": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email not verified yet"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mail ainda não verificado"
          }
        }
      }
    },
    "verify": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send verification email"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar e-mail de verificação"
          }
        }
      }
    },
    "refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have verified my email"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já verifiquei meu e-mail"
          }
        }
      }
    },
    "verificationSent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification email sent. Open the link, then return here to update your account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mail de verificação enviado. Abra o link e volte aqui para atualizar sua conta."
          }
        }
      }
    },
    "signOut": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair da conta"
          }
        }
      }
    },
    "signOutBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out on this device? Guest access cannot be recovered unless you create an account first."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair neste aparelho? O acesso de visitante não poderá ser recuperado se você não criar uma conta antes."
          }
        }
      }
    },
    "delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir conta"
          }
        }
      }
    },
    "deleteTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your account?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir sua conta?"
          }
        }
      }
    },
    "deleteBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes your authentication account. It does not erase reading data stored locally on this device. Enter your password to confirm."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente sua conta de autenticação. Não apaga os dados de leitura armazenados localmente neste aparelho. Digite sua senha para confirmar."
          }
        }
      }
    },
    "deleteGuestBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes your guest account. This action cannot be undone. Local reading data is not erased."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente sua conta de visitante. Esta ação não pode ser desfeita. Os dados locais de leitura não são apagados."
          }
        }
      }
    },
    "deleted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account deleted."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta excluída."
          }
        }
      }
    },
    "cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "working": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please wait…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde…"
          }
        }
      }
    },
    "invalidEmail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid email address."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe um e-mail válido."
          }
        }
      }
    },
    "passwordRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your password."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe sua senha."
          }
        }
      }
    },
    "passwordTooShort": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a password with at least 8 characters."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma senha com pelo menos 8 caracteres."
          }
        }
      }
    },
    "passwordMismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The passwords do not match."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As senhas não são iguais."
          }
        }
      }
    },
    "credentials": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not sign you in. Check your email and password."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível entrar. Confira seu e-mail e sua senha."
          }
        }
      }
    },
    "emailInUse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This email already has an account. Sign in or recover your password."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este e-mail já tem uma conta. Entre ou recupere sua senha."
          }
        }
      }
    },
    "network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection right now. Check your internet and try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão no momento. Confira sua internet e tente novamente."
          }
        }
      }
    },
    "tooManyRequests": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Wait a moment and try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas tentativas. Aguarde um pouco e tente novamente."
          }
        }
      }
    },
    "disabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is disabled."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta está desativada."
          }
        }
      }
    },
    "configuration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account access is not configured for this build yet. You can keep reading."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à conta ainda não está configurado nesta versão. Você pode continuar lendo."
          }
        }
      }
    },
    "recentLoginRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your security, sign in again before continuing."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por segurança, entre novamente antes de continuar."
          }
        }
      }
    },
    "unexpected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not complete this action. Please try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir esta ação. Tente novamente."
          }
        }
      }
    }
  },
  "version": "1.0"
}
