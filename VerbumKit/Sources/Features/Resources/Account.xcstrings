        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Áudio e voz"
          }
        }
      }
    },
    "audioBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open a chapter and choose Listen from its menu. The player lets you pause, move forward or back, and return to the chapter. Portuguese audio reads the translation on screen; an English recording may be offered when it is unavailable."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra um capítulo e escolha Ouvir no menu. O player permite pausar, avançar, voltar e retornar ao capítulo. O áudio em português lê a tradução na tela; uma gravação em inglês pode ser oferecida quando ele não estiver disponível."
          }
        }
      }
    },
    "voiceBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Talk about this chapter to start a conversation. Microphone access is needed only for this feature. You can manage that permission in the device settings."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha Conversar sobre este capítulo para iniciar uma conversa. O acesso ao microfone é necessário apenas para essa função. Você pode gerenciar a permissão nos ajustes do dispositivo."
          }
        }
      }
    },
