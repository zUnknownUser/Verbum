      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbum is available in English and Brazilian Portuguese. Use your device settings to choose the language for the app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Verbum está disponível em inglês e português brasileiro. Use os ajustes do dispositivo para escolher o idioma do app."
          }
        }
      }
    },
    "verbumSection" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
