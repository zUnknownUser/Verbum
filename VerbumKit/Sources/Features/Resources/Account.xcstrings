        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chapters you open are recorded on this device from this version onward. Opening a chapter does not mean you have finished reading it."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os capítulos que você abre são registrados neste dispositivo a partir desta versão. Abrir um capítulo não significa ter concluído sua leitura."
