    "bibleLanguageBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Bible follows the app language: Portuguese or English. Change the app language in your device settings."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Bíblia acompanha o idioma do app: português ou inglês. Altere o idioma do app nos ajustes do dispositivo."
          }
        }
      }
    },
