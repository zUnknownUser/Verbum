    "help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Help"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuda"
          }
        }
      }
    },
    "helpReading" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the chapter title to choose another book or chapter. Reading preferences let you adjust text size, switch between pages and continuous scrolling, and enable quiet reading."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no título do capítulo para escolher outro livro ou capítulo. Nas preferências de leitura, ajuste o tamanho do texto, escolha páginas ou rolagem contínua e ative a leitura tranquila."
          }
        }
      }
    },
    "helpSaving" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a verse to open its study panel. Use the bookmark to save it, choose a highlight, or write a note. Find these passages again in Your Verbum."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um versículo para abrir o painel de estudo. Use o marcador para salvar a passagem, escolha um destaque ou escreva uma nota. Encontre essas passagens novamente em Seu Verbum."
          }
        }
      }
    },
    "helpOffline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previously opened chapters may be available from the cache. Search, study context, voice and new audio may need an internet connection."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capítulos abertos anteriormente podem estar disponíveis no cache. Busca, contexto de estudo, voz e novos áudios podem precisar de conexão com a internet."
          }
        }
      }
    },
    "privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacidade"
          }
        }
      }
    },
    "privacyLocal" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved passages, highlights, notes and reading history stay on this device. They are not synced by signing in, and they remain on the device after signing out. Personal notes are not sent with study questions."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passagens salvas, destaques, notas e histórico ficam neste dispositivo. Entrar na conta não sincroniza esses dados, e eles permanecem no aparelho após sair. Notas pessoais não são enviadas junto das perguntas de estudo."
          }
        }
      }
    },
    "privacyAccount" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account is used to authenticate access. Account details lets you manage your email, password and account deletion. Deleting your account does not erase local reading data."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta é usada para autenticar o acesso. Em Detalhes da conta, gerencie email, senha e exclusão da conta. Excluir a conta não apaga os dados locais de leitura."
          }
        }
      }
    },
    "privacyAI" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you ask a question or use voice, your question and the relevant study context are sent to the service to produce a response. Microphone access is requested when you start a voice conversation."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao fazer uma pergunta ou usar voz, sua pergunta e o contexto relevante de estudo são enviados ao serviço para produzir uma resposta. O acesso ao microfone é solicitado ao iniciar uma conversa por voz."
          }
        }
      }
    },
    "about" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About Verbum"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobre o Verbum"
          }
        }
      }
    },
    "aboutBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You found the verse. Now understand it. Verbum brings reading, context and connections together, so your exploration can begin with Scripture."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você encontrou o versículo. Agora compreenda. O Verbum reúne leitura, contexto e conexões para que sua exploração comece nas Escrituras."
          }
        }
      }
    },
