    "bibleVersionBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbum currently reads Bíblia Livre in Portuguese and the Berean Standard Bible in English. The World English Bible is also available as an offline fallback in English."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Verbum utiliza a Bíblia Livre em português e a Berean Standard Bible em inglês. A World English Bible também está disponível como alternativa offline em inglês."
          }
        }
      }
    },
    "bibleComparisonBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To compare a verse, tap it in the reader and choose Compare. In Portuguese, the comparison uses Bíblia Portuguesa Mundial."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para comparar um versículo, toque nele durante a leitura e escolha Comparar. Em português, a comparação utiliza a Bíblia Portuguesa Mundial."
          }
        }
      }
    },
    "bibleLanguage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
